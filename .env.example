# 复制为 .env 后填自己的值，或直接 export 同名环境变量。
# 项目没有引入 python-dotenv，.env 不会被自动加载：
#   set -a; source .env; set +a

DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_NAME=weather_system_db

# 也可以跳过上面四项，直接给整串连接地址
# DATABASE_URL=mysql+pymysql://root:password@localhost/weather_system_db

# 和风天气密钥，https://console.qweather.com
HEFENG_API_KEY=

# Flask session 签名密钥，随便一串随机字符
SECRET_KEY=

# 设为 1 打印所有 SQL
SQLALCHEMY_ECHO=0
